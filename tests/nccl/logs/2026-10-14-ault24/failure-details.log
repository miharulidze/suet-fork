 	ssize_t	(*injectdata)(struct fid_ep *ep, const void *buf, size_t len,
 			uint64_t data, fi_addr_t dest_addr);
-	ssize_t	(*recv_flush)(struct fid_ep *ep, uint64_t flags);
+	int	(*recv_flush)(struct fid_ep *ep, uint64_t flags);
 };
 
 struct fi_ops_cm;
