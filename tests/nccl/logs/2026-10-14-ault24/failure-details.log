commit 42264682d5b5f0250de3b70dec309d1310313e86
Author: Jessie Yang <jiaxiyan@amazon.com>
Date:   Tue Sep 22 14:35:18 2026 -0700

    core: Add Work Request API
    
    Split the monolithic data transfer post into separate prepare, modify,
    queue, and flush stages, so an application can format a work request once
    off the critical path, attach provider-specific metadata the fi_*msg calls
    cannot express, and then repeatedly update a few fields and submit it.
    
    Add the FI_WR capability, the host-side calls in a new rdma/fi_wr.h, and
    fi_ep_attr::max_tx_wr_size and max_rx_wr_size reporting the buffer an application
    must allocate to back a struct fi_wr.
    
    Bump ABI to FABRIC_1.11 for fi_getinfo, fi_freeinfo, and fi_dupinfo since
    fi_ep_attr grows by two size_t fields. Add ABI 1.10 compat layer.
    
    Signed-off-by: Jessie Yang <jiaxiyan@amazon.com>

diff --git a/include/rdma/fi_endpoint.h b/include/rdma/fi_endpoint.h
index 8153651c6..11069d1e5 100644
--- a/include/rdma/fi_endpoint.h
+++ b/include/rdma/fi_endpoint.h
@@ -140,6 +140,7 @@ struct fi_ops_rma;
 struct fi_ops_tagged;
 struct fi_ops_atomic;
 struct fi_ops_collective;
+struct fi_ops_wr;
 
 /*
  * Calls which modify the properties of a endpoint (control, setopt, bind, ...)
@@ -159,6 +160,7 @@ struct fid_ep {
 	struct fi_ops_tagged	*tagged;
 	struct fi_ops_atomic	*atomic;
 	struct fi_ops_collective *collective;
+	struct fi_ops_wr	*wr;
 };
 
