From: SUET interoperability testbench
Subject: [PATCH] pds: replay ROD loss from Expected_PSN in PSN order

Applies after 0001 to ultraethernet/uet-ref-prov 9effe362.
A ROD_OOO NACK identifies the offending packet in nack_psn, while payload
identifies the missing Expected_PSN. Retrying only nack_psn never fills the
receiver's gap. Queue ordered GoBackN, pause new data, retain the cursor on
backpressure, and coalesce feedback according to UEC section 3.5.21.1.
Keep existing retry limits and error handling; other PDC modes are unchanged.

--- a/uet_pds.c
+++ b/uet_pds.c
@@ -185,0 +186,8 @@
+	/* ROD replay cursor is independent of the timeout-ordered Tx list. */
+	bool                 gbn_pending;
+	bool                 gbn_active;
+	bool                 gbn_retx_seen;
+	uint32_t             gbn_expected_psn;
+	uint32_t             gbn_next_psn;
+	uint32_t             gbn_end_psn;
+
@@ -662,0 +671,6 @@
+	pdc->gbn_pending = false;
+	pdc->gbn_active = false;
+	pdc->gbn_retx_seen = false;
+	pdc->gbn_expected_psn = 0;
+	pdc->gbn_next_psn = 0;
+	pdc->gbn_end_psn = 0;
@@ -2067,0 +2082,4 @@
+	/* A ROD loss event must replay older PSNs before sending new data. */
+	if (pdc->gbn_pending || pdc->gbn_active)
+		return -EAGAIN;
+
@@ -2374,0 +2393,77 @@
+/* Submit ROD GoBackN in PSN order, with a bounded batch for RX fairness.
+ * Retain the cursor on NIC backpressure or a temporarily closed peer window.
+ */
+static int uet_pds_progress_gbn(struct uet_instance *uet, struct uet_pdc *pdc)
+{
+	struct uet_pdc_pkt *pkt;
+	uet_pkt_handle_t failed;
+	unsigned int budget = 32;
+	int rc;
+
+	while (pdc->gbn_pending && budget--) {
+		if (UET_PDS_PSN_AFTER(pdc->tx_bm_base_psn, pdc->gbn_next_psn))
+			pdc->gbn_next_psn = pdc->tx_bm_base_psn;
+		if (UET_PDS_PSN_AFTER(pdc->gbn_next_psn, pdc->gbn_end_psn)) {
+			pdc->gbn_pending = false;
+			break;
+		}
+		if (!bm_get(pdc->tx_bm,
+			    pdc->gbn_next_psn - pdc->tx_bm_base_psn,
+			    (void **)&pkt) || pkt->tx_pkt_acked) {
+			pdc->gbn_next_psn++;
+			continue;
+		}
+		if (pkt->tx_retry_cnt >= uet->pds.max_tx_retries) {
+			rc = -EIO;
+		} else {
+			rc = uet_pds_rtx_pkt(uet, pdc, pkt);
+		}
+		if (rc == -EAGAIN)
+			return 0;
+		if (rc) {
+			failed = pkt->tx_pkt_handle;
+			uet_pds_close_pdc_in_error(uet, pdc);
+			uet_pds_drop_tx_pkts(NULL, failed);
+			return -EPROTO;
+		}
+		if (!pkt->tx_pkt_acked) {
+			dlist_remove(&pkt->node);
+			dlist_insert_tail(&pkt->node, &pdc->tx_pkt_list_head);
+		}
+		pdc->gbn_next_psn++;
+	}
+	return 0;
+}
+
+/* UEC 3.5.21.1: payload is Expected_PSN, nack_psn is the later packet.
+ * Coalesce feedback from one loss event, including the first retransmit loss.
+ */
+static int uet_pds_start_gbn(struct uet_instance *uet, struct uet_pdc *pdc,
+			   const struct uet_parsed_pkt *pp)
+{
+	uint32_t expected = pp->pds_payload;
+	bool retx = pp->pds_flags & UET_PDS_NACK_FLAGS_RETX;
+
+	if (UET_PDS_PSN_AFTER(pdc->tx_bm_base_psn, expected) ||
+	    UET_PDS_PSN_AFTER(expected, pp->pds_psn))
+		return 0; /* stale or invalid Expected_PSN */
+
+	if (pdc->gbn_active) {
+		if (UET_PDS_PSN_AFTER(pdc->gbn_expected_psn, expected))
+			return 0;
+		if (expected == pdc->gbn_expected_psn &&
+		    (!retx || pdc->gbn_retx_seen))
+			return 0;
+	}
+
+	pdc->gbn_active = true;
+	pdc->gbn_pending = true;
+	pdc->gbn_retx_seen = retx;
+	pdc->gbn_expected_psn = expected;
+	pdc->gbn_next_psn = expected;
+	pdc->gbn_end_psn = pdc->next_psn - 1;
+	UET_PDS_WARN("PDC %u GoBackN expected=%u end=%u retx=%u",
+		     pdc->pdc_id, expected, pdc->gbn_end_psn, retx);
+	return uet_pds_progress_gbn(uet, pdc);
+}
+
@@ -2520,0 +2616,8 @@
+		}
+
+		if (pdc->gbn_pending) {
+			rc = uet_pds_progress_gbn(uet, pdc);
+			if (rc)
+				return rc;
+			if (pdc->gbn_pending)
+				continue;
@@ -3559,0 +3663,4 @@
+	if (pp->pds_nack_code == UET_NACK_ROD_OOO &&
+	    pdc_pkt->pkt_pp.pds_type == UET_PDS_TYPE_ROD_REQ)
+		return uet_pds_start_gbn(uet, pdc, pp);
+
@@ -3655,0 +3763,6 @@
+
+	/* Any validated ACK ends NACK coalescing for the current loss event.
+	 * Already queued replay still drains before accepting new data.
+	 */
+	pdc->gbn_active = false;
+	pdc->gbn_retx_seen = false;
